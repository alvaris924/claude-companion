#!/bin/sh
# Refuses direct pushes to main; every change goes through a pull request.
# Enable once per clone:  git config core.hooksPath .githooks

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      echo "pre-push: direct pushes to main are not allowed. Push a type/topic branch and open a pull request." >&2
      exit 1
      ;;
  esac
done
exit 0
